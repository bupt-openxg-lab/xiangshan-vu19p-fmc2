# PD-VU19P-SOLO-V3 FMC2 + UV-FMCH-PDDR4DME
# 16GB KSM26SES8/16HC, one rank, 64-bit primary bus, ECC lane unused.

# Daughter-card 200 MHz oscillator: FMC CLK1_M2C.
set_property PACKAGE_PIN BJ43 [get_ports clk7_p]
set_property PACKAGE_PIN BK43 [get_ports clk7_n]
set_property IOSTANDARD LVDS [get_ports {clk7_p clk7_n}]


# DQ byte lane 0
set_property PACKAGE_PIN BR44 [get_ports {DDR0_DQ[0]}]
