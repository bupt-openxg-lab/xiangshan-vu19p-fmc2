# Copy this file to config.env and replace the example paths. The
# Vivado-specific script is preferred when Vitis is not installed; the loader
# also accepts the top-level settings64.sh wrapper.
VIVADO_SETTINGS=/path/to/Vivado/2020.2/.settings64-Vivado.sh
XILINXD_LICENSE_FILE=/path/to/xilinx.lic

# Existing clean clone of minjie-playground at the revision in
# manifests/upstream-versions.md. The scripts do not clone or delete it.
SOURCE_ROOT=/path/to/minjie-playground

VIVADO_JOBS=8
VIVADO_SYNTH_THREADS=8
RTL_JOBS=16
MIN_RAM_GIB=90
MIN_DISK_GIB=60
